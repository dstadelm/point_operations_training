Screen{
  overflow: hidden hidden;
}

AssignmentScreen {
  align: center middle;
}
#assignment {
  width: 40;
  margin: 1;
  padding: 1;
  background: $boost;
  text-align: center;
  align: center middle;
  border: round $primary;
}

ProgressBar {
  margin: 1;
}

#stats {
  margin: 1;
  border: round $primary;
}

WelcomeScreen {
    align: center middle;
}


#start {
  width: auto;
  margin: 1;
  padding: 1 5;
  text-align: center;
  border: round $primary;
  background: $surface;
}

#modus {
  width: auto;
  /* margin: 1; */
  /* text-align: center; */
  border: round;
}

#start_button {
  width: auto;
  margin: 1;

}

#matplotlib_button {
  width: auto;
  margin: 1;
}

Container {
  max-height: 50%;
  max-width: 60%;
}

ResultScreen {
    align: center middle;
}

#result_message {
    padding: 1 3;
    border: round $primary;
    background: $surface;
}

SelectUserScreen {
    align: center middle;
}

SelectModusScreen {
    align: center middle;
}


CreateNewUserScreen {
    align: center middle;
}

#UserSelectionDialog {
    align: center middle;
    content-align: center middle;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#ModusSelectionDialog {
    align: center middle;
    content-align: center middle;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#create-new-user-button {
  width: 50%;
}

QuitScreen {
    align: center middle;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

Button {
    width: 100%;
}
